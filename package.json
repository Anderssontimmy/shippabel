{
  "name": "shippabel-web",
  "private": true,
  "version": "0.1.0",
  "description": "From vibe code to Google Play in one click",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.js && node scripts/build-meta.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:edge": "deno task --config supabase/deno.json test",
    "check:edge": "deno task --config supabase/deno.json check",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:integration": "node scripts/test-integration.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/react": "^10.74.0",
    "@stripe/stripe-js": "^5.5.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-device-mockup": "^1.0.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.186.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.0",
    "deno": "^2.9.6",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.15.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
