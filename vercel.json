{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/deploy-gate.mjs && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.shippabel.com" }],
      "destination": "https://shippabel.com/:path*",
      "permanent": true
    },
    { "source": "/blog/publish-cursor-app-to-app-store", "destination": "/blog/publish-cursor-app-to-google-play", "permanent": true },
    { "source": "/blog/bolt-app-to-app-store", "destination": "/blog/publish-bolt-app-to-google-play", "permanent": true },
    { "source": "/blog/app-store-screenshots-guide", "destination": "/blog/google-play-screenshots-guide", "permanent": true },
    { "source": "/blog/apple-review-what-they-check", "destination": "/blog/google-play-review-what-they-check", "permanent": true },
    { "source": "/og-image.svg", "destination": "/og-image.png", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets/|version\\.json$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/scan/((?!demo$).+)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(dashboard|settings|admin|login|app(?:/.*)?)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/((?!(?:assets|blog|scan|pricing|about|login|privacy|dashboard|settings|admin|app|mockups|\\.well-known)(?:/|$)|(?:version\\.json|favicon\\.svg|og-image\\.png|og-image\\.svg|robots\\.txt|sitemap\\.xml|llms\\.txt)$|$).*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/mockups/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
